{
  "configVersion": "1.1.0",
  "outputDir": "_build",
  "outputFile": "guides.md",
  "compileOrder": ["features", "client", "developer", "glossary"],
  "banner": "<!-- AUTO-GENERATED by Merlon Docs \u2014 edit shards, then run: npm run compile (in docs/) -->\n\n",
  "guides": [
    {
      "name": "features",
      "compile": {
        "scopeRoot": "glossary"
      }
    },
    {
      "name": "client",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "_build/client-guide.md"
      }
    },
    {
      "name": "developer",
      "compile": {
        "scopeRoot": "glossary",
        "outputFile": "_build/developer-guide.md"
      }
    },
    {
      "name": "glossary"
    }
  ],
  "standaloneGuides": ["../AGENTS.md"],
  "scan": {
    "root": "docs",
    "strict": true,
    "ignore": [
      "_build/**",
      "styles/**",
      "node_modules/**",
      "TROUBLESHOOTING.md",
      "TESTING_PHASE6.md",
      "container-isolation-design.md"
    ]
  },
  "refs": {
    "registryFile": "_build/refs.json",
    "slugAlgorithm": "github"
  },
  "lint": {
    "markdownlint": {
      "shardsConfig": "node_modules/@merlon-docs/merlon-docs-presets/markdownlint-shards.markdownlint-cli2.jsonc",
      "compiledConfig": "node_modules/@merlon-docs/merlon-docs-presets/markdownlint-compiled.markdownlint-cli2.jsonc"
    },
    "paths": {
      "severity": "warn",
      "searchRoots": [".."],
      "generated": ["_build", "node_modules", "../.build"],
      "vocabulary": ["MacRunner.app/Contents/Resources/", "MacRunner.app"]
    }
  },
  "vale": {
    "config": ".vale.ini",
    "scanGlobs": ["features", "client", "developer", "glossary"]
  }
}
